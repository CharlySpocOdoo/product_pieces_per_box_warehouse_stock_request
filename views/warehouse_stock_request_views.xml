<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="custom_warehouse_stock_request_form_view_pieces_per_box" model="ir.ui.view">
        <field name="name">custom.warehouse.stock.request.form.pieces.per.box</field>
        <field name="model">custom.warehouse.stock.request</field>
        <field name="inherit_id"
               ref="warehouse_stock_request.custom_warehouse_stock_request_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_stock_request_line_ids']/list/field[@name='product_uom']"
                   position="after">
                <field name="pieces_per_box_display" string="Caja" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
